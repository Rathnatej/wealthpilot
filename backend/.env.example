GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Local dev default; for Supabase/Neon use postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./wealthpilot.db
CORS_ORIGINS=http://localhost:3000

# ---- Voice assistant (optional; these are the defaults) ----
VOICE_ENABLED=true
VOICE_PAID_ONLY=false
VOICE_MODEL=gemini-3.8-live
VOICE_DEFAULT=Sulafat
VOICE_FREE_DAILY_MINUTES=15
VOICE_FREE_MONTHLY_MINUTES=120
VOICE_MAX_SESSION_SECONDS=1200
VOICE_IDLE_TIMEOUT_SECONDS=120
VOICE_TOKEN_RATE_LIMIT=6
VOICE_TOKEN_RATE_WINDOW_SECONDS=600
# Comma-separated emails treated as pro (placeholder until real billing exists)
VOICE_PRO_EMAILS=
# Fernet key for transcripts: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VOICE_ENCRYPTION_KEY=
